{
  "manifest_version": 3,
  "name": "Adswish Tracker",
  "version": "1.1.0",
  "description": "Tracks Adswish affiliate conversions and pixel heartbeats without installing site code. An alternative to the adswish.com/pixel.js script.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Adswish Tracker"
  },
  "options_page": "options.html"
}
